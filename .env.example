APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-city
APPWRITE_DATABASE_ID=your_city_db
# Server-only key: sessions.write, tables.read, rows.read, rows.write.
# Audit permission updates additionally require tables.write. Never NEXT_PUBLIC.
APPWRITE_API_KEY=
# Local default only. Production requires its actual HTTPS canonical origin.
# A Vercel preview may omit this value and use trusted VERCEL_URL metadata.
# Configure the exact callback hostname as an Appwrite Web platform.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional server-controlled list. Never derive moderator roles from user input/preferences.
APPWRITE_MODERATOR_IDS=
# Project-level Vercel Firewall rate-limit IDs, configured for BOTH preview/production.
VERCEL_AUTH_RATE_LIMIT_ID=
VERCEL_WRITE_RATE_LIMIT_ID=
# VERCEL / VERCEL_URL are platform-provided. Never set them to bypass readiness checks.
