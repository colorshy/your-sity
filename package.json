{
  "name": "your-city",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "format": "prettier --write src docs *.md *.json *.mjs",
    "test:security": "tsx --test scripts/authorization.test.ts",
    "appwrite:inspect": "tsx scripts/appwrite-inspect.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "node-appwrite": "^31.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
